#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_NANO@,0
PRODUCTVERSION  @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_NANO@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Jellyfin Contributors\0"
      VALUE "FileDescription",  "Jellyfin @JWCUSTOM_VERSION_DESC@\0"
      VALUE "FileVersion",      "@VERSION_STRING@\0"
      VALUE "InternalName",     "JellyfinMediaPlayer\0"
      VALUE "LegalCopyright",   "GNU GPL v2\0"
      VALUE "OriginalFilename", "JellyfinMediaPlayer.exe\0"
      VALUE "ProductName",      "Jellyfin Media Player\0"
      VALUE "ProductVersion",   "@VERSION_STRING@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END